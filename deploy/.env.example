# Variables del stack de producción. Copiar a deploy/.env en el servidor y
# completar. Ese archivo NO va al repo (está en .gitignore) y contiene los
# secretos reales.
#
#   cp deploy/.env.example deploy/.env && nano deploy/.env

# ---- Dominios ----
# Los tres nombres deben apuntar por DNS (registro A) a la IP del servidor
# ANTES de emitir certificados: APP_DOMAIN, www.APP_DOMAIN y ML_DOMAIN.
APP_DOMAIN="evoelution.com"
ML_DOMAIN="cromatografia.evoelution.com"
LETSENCRYPT_EMAIL="tu-correo@evoelution.com"

# ---- Postgres ----
# Solo alcanzable desde la red interna de Docker: no se expone ningún puerto.
# Aun así, una contraseña larga y aleatoria:  openssl rand -base64 24
POSTGRES_USER="evoelution"
POSTGRES_PASSWORD="cambiame-por-una-contrasena-aleatoria-larga"
POSTGRES_DB="evoelution"

# ---- Auth.js ----
# GENERÁ UNO NUEVO. No reutilices el de desarrollo: quien lo tenga puede
# firmar sesiones válidas y entrar como cualquier usuario.
#   openssl rand -base64 32
AUTH_SECRET="genera-uno-nuevo-con-openssl-rand-base64-32"

# ---- App ----
NEXT_PUBLIC_WHATSAPP="525555902555"
# Conexiones de Postgres por instancia. Con `max_connections=100` (default de
# Postgres), 10 deja margen de sobra para una sola instancia + migraciones.
DB_POOL_MAX="10"

# ---- ML (evo_ai) ----
# Nombre del servicio en la red interna: no sale a internet.
ML_SERVICE_URL="http://evoai-backend:8000"

# ---- Respaldos ----
# Días que se conservan los dumps antes de borrarse.
BACKUP_RETENTION_DAYS="14"

# ---- Imágenes remotas (opcional) ----
# Hosts permitidos para <Image> externo, separados por coma. Vacío = ninguno,
# que es lo correcto hoy: no hay una sola imagen remota en el proyecto.
# NEXT_PUBLIC_IMAGE_HOSTS=""
