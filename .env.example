# Configuración de DESARROLLO. Copiar a .env.local y ajustar.
# Para producción, ver deploy/.env.example (stack Docker en el VPS).

# ---- Base de datos (Postgres) ----
# Local:  postgresql://postgres:postgres@localhost:5432/evoelution
# Supabase/Neon: usa la cadena "connection pooling" (puerto 6543 en Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evoelution"

# Prepared statements. Dejar en false detrás de un pooler en modo transaction
# (pgbouncer, el pooler de Supabase): se los rompe. Con conexión directa a
# Postgres se puede poner "true" y ahorra replanificar cada consulta.
# DB_PREPARE="false"
# Conexiones por instancia de la app (default 10).
# DB_POOL_MAX="10"

# ---- Auth.js (NextAuth v5) ----
# Genera con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="reemplaza-esto-con-un-secreto-largo-y-aleatorio"

# ---- Microservicio ML (fase 2, opcional) ----
# Declarada pero todavía SIN USO: el portal y evo_ai aún no se hablan.
ML_SERVICE_URL="http://localhost:8000"

# ---- Archivos subidos ----
# Dónde se guardan las fotos de equipos. En dev, si se omite, van a
# public/uploads. En producción es un volumen fuera del proyecto
# (/data/uploads) para que sobrevivan a cada deploy.
# UPLOADS_DIR="/data/uploads"

# ---- Público ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP="525555902555"
# Hosts permitidos para <Image> remoto, separados por coma. Vacío = ninguno.
# NEXT_PUBLIC_IMAGE_HOSTS=""
