# Configuración de DESARROLLO. Copiar a .env.local y ajustar.
# Para producción, ver deploy/.env.example (stack Docker en el VPS).

# ---- Base de datos (Postgres) ----
# Local:  postgresql://postgres:postgres@localhost:5432/evoelution
# Supabase/Neon: usa la cadena "connection pooling" (puerto 6543 en Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evoelution"

# Prepared statements. Dejar en false detrás de un pooler en modo transaction
# (pgbouncer, el pooler de Supabase): se los rompe. Con conexión DIRECTA a
# Postgres, "true".
#
# Medido, para que nadie lo persiga esperando milagros: con la sesión caliente
# ahorra ~0,2 ms de planificación por consulta. Es marginal. Lo que importa de
# ponerlo aquí es que desarrollo se comporte igual que producción.
DB_PREPARE="true"
# Conexiones del PLANO DE CONTROL por instancia de la app (default 10).
# DB_POOL_MAX="10"

# ---- Conexiones de los inquilinos ----
# Cada empresa con actividad mantiene su propio pool, así que estos números se
# multiplican por cuántas estén trabajando a la vez. El techo de la instancia es
#
#     DB_TENANT_CONN_BUDGET + DB_POOL_MAX
#
# y tiene que quedar por debajo del `max_connections` de Postgres —100 si nadie
# lo tocó— con holgura para migraciones, psql y lo que haya conectado. Pasarse
# no se nota como lentitud: se nota como «too many clients», y cae la aplicación
# entera para todos los inquilinos a la vez.
#
# El número de pools en caché se DERIVA de estos dos (presupuesto ÷ por
# inquilino). Con más inquilinos activos que pools, el menos usado se cierra y
# el siguiente que llegue paga una reconexión — milisegundos, contra un error
# duro.
# DB_TENANT_CONN_BUDGET="60"
# DB_TENANT_POOL_MAX="2"
# Segundos que un pool inactivo conserva sus conexiones antes de soltarlas.
# DB_TENANT_IDLE="20"

# ---- Auth.js (NextAuth v5) ----
# Genera con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="reemplaza-esto-con-un-secreto-largo-y-aleatorio"

# ---- Microservicio ML (fase 2, opcional) ----
# Declarada pero todavía SIN USO: el portal y evo_ai aún no se hablan.
ML_SERVICE_URL="http://localhost:8000"

# ---- Archivos subidos ----
# Dónde se guardan las fotos de equipos. En dev, si se omite, van a
# public/uploads. En producción es un volumen fuera del proyecto
# (/data/uploads) para que sobrevivan a cada deploy.
# UPLOADS_DIR="/data/uploads"

# ---- Público ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP="525555902555"
# Hosts permitidos para <Image> remoto, separados por coma. Vacío = ninguno.
# NEXT_PUBLIC_IMAGE_HOSTS=""

# Modo subdominio en desarrollo. `*.localhost` lo resuelven los navegadores al
# bucle local sin tocar DNS, así que con esto puesto podés probar el enrutado
# real en http://evoelution.localhost:3000 sin editar /etc/hosts.
# Vacío o ausente = inquilino en el path, como antes.
# ROOT_DOMAIN=localhost

# --- Plano analítico -------------------------------------------------------
# Dónde escribe el extractor los parquet del lago. En producción, un volumen
# montado FUERA del árbol de la aplicación: bajo public/ quedarían servidos
# por HTTP, que en esta tabla concreta es el peor error posible.
ANALYTICS_LAKE_DIR=/var/lib/astraion/lake

INTELLIGENCE_URL=http://intelligence:8000

# ── Correo ──────────────────────────────────────────────────────────────────
# Sin MAIL_PROVIDER no sale un solo correo de la máquina: el transporte por
# omisión imprime en consola lo que se habría mandado. Es deliberado — un aviso
# de prueba llegando al buzón de un cliente real es un incidente, no un fallo.
#
# MAIL_PROVIDER="resend"
# RESEND_API_KEY="re_..."
#
# El remitente de la PLATAFORMA: el respaldo para las empresas que todavía no
# verificaron su propio dominio. Cada empresa configura el suyo en `tenants`
# (mail_domain, mail_from, mail_verified_at); mientras no esté verificado, el
# aviso sale por aquí con el NOMBRE de la empresa.
#
# El dominio de MAIL_FROM necesita SPF + DKIM + DMARC publicados y verificados
# por el proveedor. Sin eso el correo cae en spam: desde 2024 Gmail y Outlook lo
# exigen para remitentes con volumen.
MAIL_FROM="avisos@ejemplo.com"
MAIL_FROM_NAME="Astraion"
#
# Clave con la que se CIFRAN las contraseñas de correo de cada empresa. Si no
# está, se deriva de AUTH_SECRET. Cambiarla inutiliza lo ya cifrado: cada
# empresa tendría que volver a escribir su contraseña, y el síntoma sería «el
# correo dejó de salir» sin más pista. Ver `lib/secretos`.
# MAIL_SECRET="otro-secreto-largo-y-aleatorio"

# ── Formulario de contacto del sitio público ──────────────────────────────────
# A qué empresa (su slug) le llegan los contactos de /contacto: caen en su tabla
# de leads. El sitio público es de una sola empresa y quien lo llena no tiene
# sesión, así que el destino es fijo. Vacío = evoelution.
# LEADS_TENANT="evoelution"
